    <?xml version="1.0" encoding="utf-8"?>
    <extension type="component" method="upgrade" version="5.0">
        <name>com_ambassador</name>
        <author>SRH Ambassador Project</author>
        <version>1.0.0</version>
        <description>SRH Community Hub – Clubs, Events, News, and Ambassador workflows.</description>
        <namespace path="src">SRH\Component\Ambassador</namespace>

        <install>
            <sql>
                <file driver="mysql" charset="utf8mb4">sql/install.mysql.sql</file>
            </sql>
        </install>
        <uninstall>
            <sql>
                <file driver="mysql" charset="utf8mb4">sql/uninstall.mysql.sql</file>
            </sql>
        </uninstall>

        <administration>
        <files folder="administrator">
            <folder>src</folder>
            <folder>sql</folder>
            <filename>access.xml</filename>
        </files>
    </administration>

    <api>
        <files folder="api">
            <folder>src</folder>
        </files>
    </api>
    </extension>
