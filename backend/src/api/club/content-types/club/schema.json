{
  "collectionName": "clubs",
  "info": {
    "singularName": "club",
    "pluralName": "clubs",
    "displayName": "Club"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "description": { "type": "richtext" },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "contact_email": { "type": "email" },
    "submittedBy": { "type": "relation", "relation": "manyToOne", "target": "api::user.user", "inversedBy": "clubSubmissions" },
    "ambassadors": { "type": "relation", "relation": "oneToMany", "target": "api::user.user", "inversedBy": "ambassadorClubs" },
    "members": { "type": "relation", "relation": "manyToMany", "target": "api::user.user", "inversedBy": "clubMemberships" },
    "approvalStatus": { "type": "enumeration", "enum": ["pending", "approved", "rejected"], "default": "pending" },
    "slug": { "type": "uid", "targetField": "title" }
  }
}
