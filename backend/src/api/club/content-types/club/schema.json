{
  "kind": "collectionType",
  "collectionName": "clubs",
  "info": {
    "singularName": "club",
    "pluralName": "clubs",
    "displayName": "Club"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "shortDescription": { "type": "string", "required": true, "maxLength": 180 },
    "description": { "type": "richtext" },
    "detailedDescription": { "type": "richtext", "required": true },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "gallery": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "coverImageUrl": { "type": "string" },
    "contact_email": { "type": "email" },
    "minimumMembers": { "type": "integer", "default": 5 },
    "maximumMembers": { "type": "integer", "default": 30 },
    "specialEquipmentRequired": { "type": "text" },
    "meetingFrequency": { "type": "string" },
    "recommendedFor": { "type": "string" },
    "signupNotes": { "type": "text" },
    "ambassadorFeedback": { "type": "text" },
    "rejectionReason": { "type": "text" },
    "submittedBy": { "type": "relation", "relation": "manyToOne", "target": "api::user.user", "inversedBy": "clubSubmissions" },
    "reviewedBy": { "type": "relation", "relation": "manyToOne", "target": "api::user.user", "inversedBy": "reviewedClubs" },
    "ambassadors": { "type": "relation", "relation": "manyToMany", "target": "api::user.user", "inversedBy": "ambassadorClubs" },
    "members": { "type": "relation", "relation": "manyToMany", "target": "api::user.user", "inversedBy": "clubMemberships" },
    "approvalStatus": { "type": "enumeration", "enum": ["pending", "approved", "rejected"], "default": "pending" },
    "slug": { "type": "uid", "targetField": "title" }
  }
}
