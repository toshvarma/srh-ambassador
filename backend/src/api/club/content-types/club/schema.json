{
  "kind": "collectionType",
  "collectionName": "clubs",
  "info": {
    "singularName": "club",
    "pluralName": "clubs",
    "displayName": "Club"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "shortDescription": {
      "type": "string",
      "maxLength": 180,
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "detailedDescription": {
      "type": "richtext",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "CoverImageMedia": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "contact_email": {
      "type": "email"
    },
    "minimumMembers": {
      "type": "integer",
      "default": 5
    },
    "maximumMembers": {
      "type": "integer",
      "default": 30
    },
    "specialEquipmentRequired": {
      "type": "text"
    },
    "meetingFrequency": {
      "type": "string"
    },
    "recommendedFor": {
      "type": "string"
    },
    "signupNotes": {
      "type": "text"
    },
    "ambassadorFeedback": {
      "type": "text"
    },
    "rejectionReason": {
      "type": "text"
    },
    "submittedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user.user",
      "inversedBy": "clubSubmissions"
    },
    "reviewedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user.user",
      "inversedBy": "reviewedClubs"
    },
    "ambassadors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user.user",
      "inversedBy": "ambassadorClubs"
    },
    "members": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user.user",
      "inversedBy": "clubMemberships"
    },
    "approvalStatus": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    }
  }
}
