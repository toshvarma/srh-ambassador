{
  "kind": "collectionType",
  "collectionName": "users",
  "info": {
    "singularName": "user",
    "pluralName": "users",
    "displayName": "Student"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "role": {
      "type": "enumeration",
      "required": true,
      "default": "Student",
      "enum": [
        "Student",
        "ExchangeStudent",
        "Professor",
        "Teacher",
        "Ambassador",
        "Admin",
        "SuperAdmin"
      ]
    },
    "status": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "active",
        "inactive",
        "pending"
      ]
    },
    "universityAffiliation": {
      "type": "string"
    },
    "enrollmentYear": {
      "type": "integer"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "bio": {
      "type": "richtext"
    },
    "clubSubmissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::club.club",
      "mappedBy": "submittedBy"
    },
    "reviewedClubs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::club.club",
      "mappedBy": "reviewedBy"
    },
    "eventAttendances": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event",
      "mappedBy": "attendees"
    },
    "clubMemberships": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::club.club",
      "mappedBy": "members"
    },
    "ambassadorClubs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::club.club",
      "mappedBy": "ambassadors"
    },
    "newsPublished": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news-item.news-item",
      "mappedBy": "author"
    }
  }
}
