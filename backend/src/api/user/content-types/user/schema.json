{
  "collectionName": "users",
  "info": {
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "role": {
      "type": "enumeration",
      "enum": ["Student", "ExchangeStudent", "Professor", "Teacher", "Ambassador", "Admin", "SuperAdmin"],
      "required": true,
      "default": "Student"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "inactive", "pending"],
      "default": "pending"
    },
    "universityAffiliation": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "enrollmentYear": {
      "type": "integer"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "bio": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "clubSubmissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::club.club",
      "inversedBy": "submittedBy"
    },
    "eventAttendances": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event",
      "inversedBy": "attendees"
    },
    "clubMemberships": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::club.club",
      "inversedBy": "members"
    },
    "ambassadorClubs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::club.club",
      "inversedBy": "ambassadors"
    },
    "articlesPublished": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news-article.news-article",
      "inversedBy": "author"
    },
    "newsPublished": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news.news",
      "inversedBy": "author"
    }
  }
}
