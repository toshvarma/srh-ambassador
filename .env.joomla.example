# ── Joomla Backend URL ────────────────────────────────────────────────────────
# Set this to the URL where your Joomla instance is running in Laragon.
# Examples:
#   http://joomla.test            (Laragon pretty URL)
#   http://localhost/joomla       (subfolder install)
NEXT_PUBLIC_JOOMLA_API_URL=http://joomla.test

