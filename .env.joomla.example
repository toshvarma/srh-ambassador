# ── Joomla Backend URL ────────────────────────────────────────────────────────
# Set this to the base URL of your Joomla instance in Laragon.
# Laragon creates pretty URLs using the folder name + .test, e.g.:
#   Folder: C:\laragon\www\joomla-cms   →   URL: http://joomla-cms.test
#   Folder: C:\laragon\www\joomla       →   URL: http://joomla.test
#
# To find your URL: open the Laragon tray icon → "WWW" to see your sites.
NEXT_PUBLIC_JOOMLA_API_URL=http://joomla-cms.test

# ── Legacy / Strapi (keep for reference, no longer used) ──────────────────────
# NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
